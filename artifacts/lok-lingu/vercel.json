{
  "ignoreCommand": "! git log -1 --pretty=%B | grep -qi '\\[deploy\\]'",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
